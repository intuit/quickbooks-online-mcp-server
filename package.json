{
    "name": "@qboapi/qbo-mcp-server",
    "version": "0.0.1",
    "description": "MCP server implementation for QuickBooks Online integration",
    "license": "MIT",
    "author": {
        "name": "Intuit",
        "url": "https://www.intuit.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/intuit/quickbooks-online-mcp-server"
    },
    "homepage": "https://github.com/intuit/quickbooks-online-mcp-server",
    "bugs": {
        "url": "https://github.com/intuit/quickbooks-online-mcp-server/issues"
    },
    "main": "dist/index.js",
    "type": "module",
    "bin": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && shx chmod +x dist/*.js",
        "prepare": "npm run build",
        "watch": "tsc --watch",
        "lint:fix": "eslint --fix",
        "lint": "eslint .",
        "auth": "node dist/auth-server.js",
        "manifest:sync": "npm run build && node dist/mcpb/manifest-sync.js",
        "manifest:check": "node dist/mcpb/manifest-sync.js --check",
        "bundle": "npm run build && npm run manifest:check && node dist/mcpb/build-bundle.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.26.0",
        "dotenv": "^16.4.7",
        "intuit-oauth": "^4.2.5",
        "node-quickbooks": "^2.0.43",
        "open": "^9.1.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@anthropic-ai/mcpb": "^2.1.2",
        "@eslint/js": "^9.22.0",
        "@jest/globals": "^30.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "globals": "^16.0.0",
        "jest": "^30.2.0",
        "prettier": "3.5.3",
        "shx": "^0.3.4",
        "ts-jest": "^29.4.6",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    },
    "overrides": {
        "node-quickbooks": {
            "fast-xml-parser": "^5.10.1",
            "underscore": "^1.13.8",
            "uuid": "11.1.1"
        }
    }
}
